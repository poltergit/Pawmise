PORT=8787
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/pawmise
# one passcode per partner (different strings); the server derives who you are from it
PAWMISE_KEY_A=long-random-string-for-A
PAWMISE_KEY_B=another-long-random-string-for-B
# web push: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com
# your Netlify URL(s), comma separated, no trailing slash
ALLOWED_ORIGIN=http://localhost:8888,https://your-site.netlify.app
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
APP_TZ=Asia/Manila
